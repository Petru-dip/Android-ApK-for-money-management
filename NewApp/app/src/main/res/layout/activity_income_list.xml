<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/toolbar_include"
        layout="@layout/include_toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_income_period"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:hint="Perioadă"
        app:layout_constraintTop_toBottomOf="@id/toolbar_include"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/dropdown_income_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:clickable="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:id="@+id/filters_scroll_income"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/til_income_period"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_income_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_income_type_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Toate"
                    android:checked="true"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_income_type_personal"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Personal"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_income_type_firma"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Firmă"/>
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_income_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Toate"
                    android:checked="true"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_income_salariu"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Salariu"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_income_Bonus"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Bonus"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_income_familie"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Familie"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_income_primit"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Primit"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_income_altele"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:text="Alte Venituri"/>
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:id="@+id/income_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sort_income"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ordine: dată (recent)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_income_report"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Raport" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/income_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintTop_toBottomOf="@id/income_actions"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/empty_view_incomes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_incomes_yet"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
